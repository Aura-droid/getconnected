rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function adminDocActive() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        adminDocActive()
      );
    }

    function ownerUserUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      // The owner may freely edit their own profile (including flipping between
      // seeker/employer intent); only admin-managed fields stay locked.
      let touchesRestricted = changed.hasAny([
        "uid",
        "verificationLevel",
        "accountDisabled",
        "accountStatus",
        "statusUpdatedBy",
        "statusUpdatedAt",
        "verifiedBy",
        "verifiedAt",
        "reviewedBy",
        "reviewedAt",
        "updatedBy",
        "updatedAt"
      ]);

      let verificationStatusOk =
        !changed.hasAny(["verificationStatus"]) ||
        request.resource.data.verificationStatus == "pending";

      return !touchesRestricted && verificationStatusOk;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == adminId);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && ownerUserUpdateAllowed());
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;
      // Participants may only touch conversation bookkeeping fields — never swap
      // themselves in/out of the participant list.
      allow update: if signedIn() &&
        request.auth.uid in resource.data.users &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "id",
          "users",
          "lastMessage",
          "lastSenderId",
          "lastTimestamp",
          "lastReadBy",
          "unreadCount",
          "typing",
          "archivedBy",
          "mutedBy",
          "hiddenBy",
          "updatedAt"
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return signedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        }

        allow read: if isParticipant();
        allow create: if isParticipant() &&
          request.resource.data.senderId == request.auth.uid;
        // Participants may only maintain read receipts, per-user hidden state and
        // reactions; message content is immutable once sent.
        allow update: if isParticipant() &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["readBy", "deletedFor", "reactions"]);
        // A message can only be deleted for everyone by the person who sent it.
        allow delete: if isParticipant() && resource.senderId == request.auth.uid;
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if signedIn();
      // Owners/employers manage their listing; anyone signed-in may only bump the
      // public view counter (it is otherwise never incremented — the rule used to
      // deny it for every jobseeker, silently).
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.employerId ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["views"])
      );
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.employerId
      );
    }
  }
}
